<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Kurfanova-Muzik-Windows</AssemblyName>
    <RootNamespace>KurfanovaMuzik</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.2.0</Version>
    <AssemblyTitle>Kurfamüzik</AssemblyTitle>
    <Product>Kurfamüzik</Product>
    <Company>KurfaCore</Company>
    <Authors>Ozan Sarsılmaz (KurfaCore)</Authors>
    <Description>Kurfamüzik Windows Masaüstü Uygulaması</Description>
    <Copyright>Copyright © 2026 KurfaCore</Copyright>
    <NeutralLanguage>tr-TR</NeutralLanguage>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
    <EmbeddedResource Include="tray.ico" />
    <EmbeddedResource Include="tray-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
